{
  "name": "ember-data-table",
  "version": "3.0.0",
  "description": "Data tables for Ember following Google Design specs",
  "keywords": [
    "ember-addon",
    "mu-semtech"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mu-semtech/ember-data-table"
  },
  "license": "MIT",
  "author": "Erika Pauwels",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.7",
    "ember-math-helpers": "^2.18.0",
    "ember-truth-helpers": "^3.0.0",
    "lodash.upperfirst": "^4.3.1"
  },
  "engines": {
    "node": ">= 18"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.js",
    "type": "addon",
    "version": 2,
    "app-js": {
      "./components/data-table.js": "./dist/_app_/components/data-table.js",
      "./components/data-table/data-cell.js": "./dist/_app_/components/data-table/data-cell.js",
      "./components/data-table/data-cells.js": "./dist/_app_/components/data-table/data-cells.js",
      "./components/data-table/data-table-content-body.js": "./dist/_app_/components/data-table/data-table-content-body.js",
      "./components/data-table/data-table-content-header.js": "./dist/_app_/components/data-table/data-table-content-header.js",
      "./components/data-table/data-table-content.js": "./dist/_app_/components/data-table/data-table-content.js",
      "./components/data-table/data-table-menu-general.js": "./dist/_app_/components/data-table/data-table-menu-general.js",
      "./components/data-table/data-table-menu-selected.js": "./dist/_app_/components/data-table/data-table-menu-selected.js",
      "./components/data-table/data-table-menu.js": "./dist/_app_/components/data-table/data-table-menu.js",
      "./components/data-table/number-pagination.js": "./dist/_app_/components/data-table/number-pagination.js",
      "./components/data-table/row.js": "./dist/_app_/components/data-table/row.js",
      "./components/data-table/text-search.js": "./dist/_app_/components/data-table/text-search.js",
      "./components/data-table/th-sortable.js": "./dist/_app_/components/data-table/th-sortable.js",
      "./components/raw-data-table.js": "./dist/_app_/components/raw-data-table.js"
    },
    "app-styles": {
      "./styles/ember-data-table.scss": "./dist/styles/ember-data-table.scss"
    }
  },
  "volta": {
    "extends": "../package.json"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-class-static-block": "^7.27.1",
    "@embroider/addon-dev": "^8.0.1",
    "@rollup/plugin-babel": "^6.0.4",
    "ember-template-lint": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^12.2.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-qunit": "^8.1.2",
    "prettier": "^3.3.3",
    "rollup": "^4.41.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.1.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./test-support": "./dist/test-support/index.js",
    "./addon-main.js": "./addon-main.js"
  },
  "files": [
    "addon-main.js",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "prepublishOnly": "rollup --config",
    "start": "rollup --config --watch"
  }
}
